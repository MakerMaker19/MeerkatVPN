package main

import (
	"fmt"

	"github.com/nbd-wtf/go-nostr/nip19"
)

func main() {
	sk := "b3fd885722af2e29f340cb1bddc8e420ad3fb6003fc828844c00b0e6b5200cd5"
	pk := "4cb03ad56b84dc22f4870a9a7412412bebce44d3ce7bf3233513478aaac31aaa"

	nsec, err := nip19.EncodePrivateKey(sk)
	if err != nil {
		panic(err)
	}
	npub, err := nip19.EncodePublicKey(pk)
	if err != nil {
		panic(err)
	}

	fmt.Println("nsec:", nsec)
	fmt.Println("npub:", npub)
}
